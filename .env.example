# PostgreSQL connection string (local dev; in production docker-compose sets
# DATABASE_URL itself from DB_PASSWORD below)
DATABASE_URL=postgresql://portal:portal@localhost:5432/portal
# Production only — the Postgres password used by docker-compose.prod.yml
DB_PASSWORD=

# Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google sign-in (optional) — Google Cloud Console OAuth client.
# Leave blank to hide the "Continue with Google" button.
# Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="Avix Digital <portal@avixdigital.com>"
# Where admin-facing notification emails go
ADMIN_NOTIFICATION_EMAIL=akibzawayed0079@gmail.com

# Direct (non-pooled) DB connection — used only by prisma migrate.
# Locally: same as DATABASE_URL. On Supabase: the "Direct connection" string.
DIRECT_URL=postgresql://portal:portal@localhost:5432/portal

# Uploaded files root (invoice PDFs, editor images, deliverables) — used when
# the Supabase storage vars below are NOT set, or when STORAGE_BACKEND=disk.
# On a real host make this an ABSOLUTE path OUTSIDE the deploy directory;
# "./uploads" is relative to the process cwd and a clean redeploy wipes it.
UPLOAD_DIR=./uploads

# Supabase Storage (optional) — set these on hosts without a persistent disk
# (e.g. Hostinger web apps). Files then live in a private Supabase bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Force local/VPS disk even when the Supabase keys above are present.
# Leave blank to use Supabase whenever SUPABASE_URL + SERVICE_ROLE_KEY are set.
# Only accepted value: disk
STORAGE_BACKEND=

# Scheduled work (meeting reminders, retainer generation, campaign drains,
# overdue-invoice chasing). Without this, /api/cron/duties answers 503 and the
# duties only run when an admin loads a page — a campaign scheduled for 3am
# waits until someone opens the app. Generate with: openssl rand -hex 32
# Then ping <NEXT_PUBLIC_APP_URL>/api/cron/duties every 15 min. Prefer the
# header form — a query string ends up in access logs:
#   curl -fsS -H "x-cron-secret: $CRON_SECRET" <APP_URL>/api/cron/duties
# The ?key=<CRON_SECRET> form also works for monitors that can't set headers.
CRON_SECRET=

# Super admin bootstrap (created automatically on first boot)
SEED_ADMIN_EMAIL=akibzawayed0079@gmail.com
SEED_ADMIN_PASSWORD=
