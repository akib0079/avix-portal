# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no values — only the variable names and
# what each one does. Keeping it ignored meant the one file documenting the
# required configuration never reached the repo.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env + uploaded files (anchored to repo root so it doesn't match
# source paths like src/app/api/uploads/)
.env
/uploads/

# server backups
backups/
.claude/scheduled_tasks.lock
